PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/cbdp
JWT_SECRET=your_super_secret_jwt_key_here

# Email Delivery Configuration (Used for sending 6-digit verification codes)
# Standard SMTP:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM="CBDP Human Resources" <no-reply@cbdp.org>

# Or Serverless Direct HTTP API:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
