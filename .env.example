PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/cbdp
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend API URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Optional Google Maps JavaScript & Places API Key
VITE_GOOGLE_MAPS_API_KEY=

# Email Service Configuration (Required for sending 6-digit password reset codes to real inboxes)
# Option A: Standard SMTP (Gmail, Brevo, AWS SES, SendGrid SMTP, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM="CBDP Human Resources" <no-reply@cbdp.org>

# Option B: Serverless Direct REST API (Recommended for Vercel where outbound SMTP ports may be filtered)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
